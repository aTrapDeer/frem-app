# =============================================
# Turso Database Configuration
# =============================================
# Get these from your Turso dashboard: https://turso.tech/
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# =============================================
# NextAuth Configuration
# =============================================
# Generate (any OS):  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=your-nextauth-secret-key

# Your app URL (no trailing slash)
# Local development:
NEXTAUTH_URL=http://localhost:3000
# Vercel production: https://your-app-name.vercel.app
# (Update this in Vercel dashboard → Settings → Environment Variables)

# =============================================
# Google OAuth Configuration
# =============================================
# Get these from Google Cloud Console: https://console.cloud.google.com/
# 1. Create a new project or select existing
# 2. Go to "APIs & Services" > "Credentials"
# 3. Create "OAuth 2.0 Client ID" (Web application)
# 4. Add authorized redirect URIs:
#    - Local: http://localhost:3000/api/auth/callback/google
#    - Production: https://your-app-name.vercel.app/api/auth/callback/google
#    (You can use the same Client ID/Secret for both environments)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# =============================================
# Credential Encryption (required for bank sync)
# =============================================
# Encrypts Plaid access tokens and Mercury API keys before they are stored in
# Turso, so a database leak alone cannot be used to read anyone's bank data.
# Generate (any OS):  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this key makes every existing bank connection undecryptable — users
# would have to re-link. Treat it like a database password.
ENCRYPTION_KEY=your-base64-32-byte-key

# =============================================
# Plaid (bank aggregation)
# =============================================
# Get these from https://dashboard.plaid.com/developers/keys
# PLAID_ENV: sandbox | production
# Sandbox needs no approval and returns realistic test data.
# Sandbox login is username "user_good" / password "pass_good".
PLAID_CLIENT_ID=your-plaid-client-id
PLAID_SECRET=your-plaid-secret-for-the-selected-env
PLAID_ENV=sandbox

# =============================================
# Mercury (business banking)
# =============================================
# Optional. Plaid does NOT support the Transactions product for Mercury, so
# Mercury transaction history comes from Mercury's own API instead.
# Create a READ-ONLY token at https://mercury.com → Settings → API tokens.
MERCURY_API_TOKEN=

# =============================================
# Scheduled sync (production only)
# =============================================
# Protects /api/cron/daily-sync. Without it the route refuses to run, since an
# open trigger for billable Plaid calls is worse than a missed sync.
# Vercel sends this automatically as a Bearer token to scheduled routes.
# Generate (any OS):  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CRON_SECRET=

# Public URL Plaid should call when an Item has new data. Defaults to
# NEXTAUTH_URL. Localhost is ignored because Plaid cannot reach it -- local
# development uses the manual sync button instead.
PLAID_WEBHOOK_URL=

# iOS OAuth client ID (Google Cloud Console → Credentials → "OAuth 2.0 Client ID" of
# type "iOS"). Required for native sign-in via /api/auth/mobile: the endpoint only
# accepts Google ID tokens whose audience matches GOOGLE_CLIENT_ID or this value.
# It must match `CLIENT_ID` in ios-app/FREM (the reverse of the URL scheme in Info.plist).
# Not a secret — iOS client IDs are public and have no client secret.
GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com

